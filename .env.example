# ============================================================
# Aggressive Stock Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# Anthropic API Key (powers the AI analysis)
# Signup: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OPTIONAL: Market Data ────────────────────────────────────
# Alpha Vantage (fundamental data, earnings, options)
# Free: 25 calls/day — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Polygon.io (real-time quotes, options flow)
# Free tier via Alpaca — https://alpaca.markets/
POLYGON_API_KEY=

# ── OPTIONAL: SEC Filings ───────────────────────────────────
# SEC API (insider trading, institutional filings)
# Free: 100 requests/day — https://sec-api.io/
# Leave empty to use free edgartools library as fallback
SEC_API_KEY=

# ── OPTIONAL: Social Sentiment ──────────────────────────────
# Reddit API (WallStreetBets, stock sentiment)
# Free: Create app at https://www.reddit.com/prefs/apps
# Leave empty to use fallback social data
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── OPTIONAL: Avanza Broker (Swedish) ───────────────────────
# For auto-trading integration
AVANZA_USERNAME=
AVANZA_PASSWORD=

# ── BEHAVIOR ─────────────────────────────────────────────────
# Auto-execute trades without confirmation (true/false)
# WARNING: Only set to 'true' if you understand the risks!
AUTO_EXECUTE=false
