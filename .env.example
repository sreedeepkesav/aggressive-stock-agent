# ============================================================
# Stock Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── LLM MODE ───────────────────────────────────────────────
# Controls AI usage and cost. Default "off" = $0/month.
#   off    = No LLM calls, pure algorithmic analysis ($0)
#   haiku  = Claude Haiku for summaries (~$0.0003/run)
#   sonnet = Claude Sonnet for deep analysis (~$0.01/run)
LLM_MODE=off

# Only needed when LLM_MODE is haiku or sonnet
ANTHROPIC_API_KEY=

# ── RISK PARAMETERS (all configurable) ─────────────────────
# Max position as fraction of portfolio (default: 0.10 = 10%)
# MAX_POSITION_PCT=0.10

# Max total portfolio risk (default: 0.08 = 8%)
# MAX_PORTFOLIO_HEAT=0.08

# Stop trading at this drawdown from peak (default: -0.10 = -10%)
# DRAWDOWN_CIRCUIT_BREAKER=-0.10

# Max number of open positions (default: 5)
# MAX_SIMULTANEOUS_POSITIONS=5

# Max allocation to one sector (default: 0.40 = 40%)
# MAX_SECTOR_CONCENTRATION=0.40

# Min cash reserve (default: 0.20 = 20%)
# CASH_RESERVE_PCT=0.20

# Daily risk tolerance (default: 0.05 = 5%)
# MAX_DAILY_RISK=0.05

# Min profit target (default: 0.08 = 8%)
# MIN_PROFIT_TARGET=0.08

# ATR multiplier for swing trade stops (default: 2.0)
# STOP_LOSS_ATR_SWING=2.0

# ATR multiplier for position trade stops (default: 2.5)
# STOP_LOSS_ATR_POSITION=2.5

# ── OPTIONAL: Avanza Broker (Swedish) ─────────────────────
# AVANZA_USERNAME=
# AVANZA_PASSWORD=
# AVANZA_TOTP_SECRET=

# ── CACHE & LOGGING ───────────────────────────────────────
# Data cache TTL in seconds (default: 300 = 5 minutes)
# CACHE_TTL_SECONDS=300

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
